---
# The variables file used by the playbooks on all hosts.
# These don't have to be explicitly imported by vars_files: they are autopopulated.

ansible_python_interpreter: /usr/bin/python3
#timeout: 120
ansible-ssh-timeout: 120
ansible_connection: ssh
ansible_become: yes
ansible_become_method: sudo
ansible_port: 22
ansible_user: alpine-admin
ansible_add_port: 22
ansible_add_user: alpine-admin
ansible_add_user_uid: 1001
ansible_ssh_private_key_file: ~/.ssh/id_ed25519
ansible_user_publickey: ~/.ssh/id_ed25519.pub

ansible_local_kubeconfig: "{{ lookup('env', 'HOME') }}/.kube/config"
ansible_controller_workdir: "{{ playbook_dir }}"
longhorn_values_remote_path: /tmp/longhorn_values.1.10.1.yaml

block_device: /dev/sda
kafka_disk_size_gib: 22.0

#dns1: 8.8.8.8
#dns2: 8.8.4.4
#dns3: 2001:4860:4860::8888
#dns4: 2001:4860:4860::8844

dns1: 1.1.1.1
dns2: 1.0.0.1
dns_search: example.com

vm_swappiness: 0
vm_vfs_cache_pressure: 100

loadbalancer_ipv4: 203.0.113.10
loadbalancer_port: 6443
loadbalancer_node_port: 6443
loadbalancer_fqdn: k8s.example.com

k3s_version: "v1.35.0+k3s1"

k3s_token: CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

cluster_cidr: "10.42.0.0/16"
service_cidr: "10.43.0.0/16"
service_node_port_range: "30000-32767"
cluster_dns: "10.43.0.10"

flannel_backend: vxlan
egress_selector_mode: cluster
flannel_interface: eth0

control_plane_ips:
  - 203.0.113.11
  - 203.0.113.12
  - 203.0.113.13

worker_ips:
  - 203.0.113.21
  - 203.0.113.22
  - 203.0.113.23
  - 203.0.113.24
  - 203.0.113.25

haproxy_api: 203.0.113.10
haproxy_mqtt1: 203.0.113.31
haproxy_mqtt2: 203.0.113.32
haproxy_mqtt3: 203.0.113.33
haproxy_lb1: 203.0.113.34

# Which control-plane host should run kubectl
alpine_k3s_coredns_control_plane_host: control1

# Kubeconfig path on that host
alpine_k3s_coredns_kubeconfig: /etc/rancher/k3s/k3s.yaml

# Target objects
alpine_k3s_coredns_namespace: kube-system
alpine_k3s_coredns_deploy_name: coredns

# Desired state
alpine_k3s_coredns_replicas: 2
alpine_k3s_coredns_pdb_name: coredns-pdb
alpine_k3s_coredns_pdb_min_available: 1

# Label selector for CoreDNS pods in k3s
alpine_k3s_coredns_label_selector:
  k8s-app: kube-dns

longhorn_namespace: longhorn-system

longhorn_csi_controller_deployments:
  - csi-attacher
  - csi-provisioner
  - csi-resizer
  - csi-snapshotter

longhorn_csi_controller_patch:
  spec:
    template:
      spec:
        nodeSelector:
          node-role.kubernetes.io/control-plane: "true"   # keep as STRING
        tolerations:
          - key: node-role.kubernetes.io/control-plane
            operator: Exists
            effect: NoSchedule
          - key: node-role.kubernetes.io/master
            operator: Exists
            effect: NoSchedule
          - key: CriticalAddonsOnly
            operator: Exists
            effect: NoSchedule

# Common Longhorn storageclass settings
longhorn_sc_common:
  provisioner: driver.longhorn.io
  allowVolumeExpansion: true
  reclaimPolicy: Delete
  volumeBindingMode: Immediate
  parameters:
    staleReplicaTimeout: "30"
    fromBackup: ""
    fsType: "ext4"
    dataLocality: "disabled"
    unmapMarkSnapChainRemoved: "ignored"
    disableRevisionCounter: "true"
    dataEngine: "v1"
    backupTargetName: "default"

# Desired replication-factor StorageClasses
# Set exactly one to is_default: true (currently rf2)
longhorn_rf_storageclasses:
  - name: longhorn-rf1
    replicas: "1"
    is_default: false
  - name: longhorn-rf2
    replicas: "2"
    is_default: true
  - name: longhorn-rf3
    replicas: "3"
    is_default: false

